__pycache__/
*.pyc
.venv/
.env
*.db
*.db-shm
*.db-wal
.DS_Store
.pytest_cache/
.ruff_cache/
dist/

# Personal runtime data — strategies are authored per-user via chat, memory is
# written by the agent. Anchored to repo root so allpath_trade/memory (code)
# stays tracked. Example strategy: docs/examples/strategy-example.yaml
/strategies/
/memory/
# shadow-dual-active T2: migrate_files.py's pre-migration backups are
# timestamped SIBLINGS of the two directories above (e.g.
# /memory.bak-20260820120000/), so the exact-name patterns above don't cover
# them -- without this, a legacy install's first run after upgrading would
# leave an untracked-but-not-ignored personal-data directory sitting in the
# repo root, one `git add -A` away from being committed.
/memory.bak-*/
/strategies.bak-*/
