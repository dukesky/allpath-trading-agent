# Alpaca (paper account keys from https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# LLM providers (used from Phase 3 on; can also be set from the web
# interface's Settings page once `serve` is running)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# SQLite trade journal location (default: allpath-trade.db in the working directory)
# DB_PATH=allpath-trade.db

# Email notifications (optional; console fallback when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_TO=

# Push notifications via ntfy (optional; https://ntfy.sh or self-hosted).
# Install the ntfy app, subscribe to a topic, and paste that topic's URL
# here -- no account, one HTTP call, instant phone banner. Can be set
# alongside email above; both fire on every notification. On ntfy.sh a topic
# is protected only by its name's obscurity, and notification bodies carry
# tickers, order sides, and rejection detail -- use a long, unguessable
# topic name; anyone who knows it can read your notifications.
NTFY_URL=

# Sentinel
SENTINEL_INTERVAL_MINUTES=60
STRATEGIES_DIR=strategies

# LLM (Phase 3): provider = openrouter | openai | anthropic
LLM_PROVIDER=openrouter
# chat: conversation with you. review: hourly sentinel checks (cheap, narrow).
# memory: nightly consolidation — decides what enters long-term memory.
CHAT_MODEL=anthropic/claude-sonnet-5
REVIEW_MODEL=anthropic/claude-haiku-4.5
MEMORY_MODEL=anthropic/claude-opus-5

# Web interface (allpath-trade serve). WEB_HOST defaults to 127.0.0.1
# (this machine only). To reach the dashboard/chat from your phone on the
# same network, set WEB_HOST=0.0.0.0 (or pass --host 0.0.0.0 to `serve`) --
# that puts the app on your LAN, so only do it on a network you trust:
# there is no built-in HTTPS, and access is gated purely by the WEB_TOKEN
# below (session cookie, not a password). Anyone on the LAN who has the
# token can reach it.
WEB_HOST=127.0.0.1
WEB_PORT=8791
# WEB_TOKEN is generated and written here automatically on first `serve` —
# leave it blank; the Settings page can reset it later.
WEB_TOKEN=
# Approve-by-link (optional): the externally-reachable base URL for this
# server, e.g. "http://192.168.1.20:8791" on your LAN. When set, sentinel
# notifications (email/ntfy) include a one-tap "Approve"/"Reject" link
# built from it; when blank (the default), notifications carry no links at
# all. Also settable from the web Settings page (Access section).
WEB_BASE_URL=
CONTEXT_BUDGET_TOKENS=60000
DAILY_CONSOLIDATION=true
CONSOLIDATE_AFTER_CHAT=true

# Phase 6: after-close daily reflection (uses the memory-tier model above).
# Tool-call budget for one reflection session -- separate from a live chat's
# limit since nobody is there to say "keep going" once it hits the cap.
REFLECTION_MAX_ITERS=12
# Turn the after-close reflection job on/off, same pattern as
# DAILY_CONSOLIDATION. Not on the Settings page yet -- .env only.
DAILY_REFLECTION=true

# Ops-hardening: explicit request timeout (seconds) for every LLM SDK call
# (chat/review/memory tiers alike). Without this, a genuinely hung call
# (not erroring -- hanging) falls back to the SDK's own default (~10min),
# long enough to block the whole after-close chain (digest -> reflection ->
# consolidation) and stall every sentinel tick behind it. 180s is generous
# for reflection's Opus calls over big prompts, but finite. Not on the
# Settings page yet -- .env only, same as REFLECTION_MAX_ITERS above.
LLM_TIMEOUT_SECONDS=180
# Wall-clock cap (seconds) for ONE account's reflection session. With two
# accounts running nightly, one slow session must not eat the whole night;
# past the deadline the session is forced to wrap up and write its report.
# 0 disables. .env only.
REFLECTION_DEADLINE_SECONDS=1800

# Telegram chat channel (optional): create a bot with @BotFather on Telegram
# (/newbot) and paste the token it gives you here. Empty (the default) means
# the Telegram channel is off entirely -- no poller runs, no pairing works.
TELEGRAM_BOT_TOKEN=
