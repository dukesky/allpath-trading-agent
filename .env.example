# Alpaca (paper account keys from https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# LLM providers (used from Phase 3 on; set via Web UI later)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# SQLite trade journal location (default: tradewind.db in the working directory)
# DB_PATH=tradewind.db

# Email notifications (optional; console fallback when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_TO=

# Sentinel
SENTINEL_INTERVAL_MINUTES=60
STRATEGIES_DIR=strategies
